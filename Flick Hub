local function addFullBorder(parent, t)
	local c = Color3.fromRGB(255,0,0)
	for _,v in ipairs({
		{UDim2.new(1,0,0,t), UDim2.new(0,0,0,0)},
		{UDim2.new(1,0,0,t), UDim2.new(0,0,1,-t)},
		{UDim2.new(0,t,1,0), UDim2.new(0,0,0,0)},
		{UDim2.new(0,t,1,0), UDim2.new(1,-t,0,0)}
	}) do
		local f = Instance.new("Frame")
		f.Size, f.Position = v[1], v[2]
		f.BackgroundColor3 = c
		f.BorderSizePixel = 0
		f.Parent = parent
	end
end

