local function btn(text)
	local b = Instance.new("TextButton", scroll)
	b.Size = UDim2.new(1,-20,0,30)
	b.BackgroundColor3 = Color3.fromRGB(0,0,0)
	b.TextColor3 = Color3.fromRGB(255,0,0)
	b.Font = Enum.Font.Arcade
	b.TextSize = 16
	b.Text = text
	addFullBorder(b,2)
	return b
end

local espBtn   = btn("ESP")
local aimBtn   = btn("Aimbot")
local fovBtn   = btn("Max FOV")
local speedBtn = btn("Legit Speed")

local function toggle(b,on)
	b.BackgroundColor3 = on and Color3.fromRGB(255,0,0) or Color3.fromRGB(0,0,0)
	b.BackgroundTransparency = on and 0.4 or 0
end

--------------------------------------------------
-- ESTADOS
--------------------------------------------------
local ESP, AIM, FOV, SPEED = false,false,false,false
local Highlights = {}
local DEFAULT_FOV = Camera.FieldOfView

--------------------------------------------------
-- ESP IMORTAL
--------------------------------------------------
local function createESP(plr)
	if Highlights[plr] then Highlights[plr]:Destroy() end
	if not plr.Character then return end

	local h = Instance.new("Highlight")
	h.Adornee = plr.Character
	h.FillColor = Color3.fromRGB(255,0,0)
	h.OutlineColor = Color3.fromRGB(255,0,0)
	h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	h.Parent = workspace
	Highlights[plr] = h
end

local function watchPlayer(plr)
	plr.CharacterAdded:Connect(function()
		task.wait(0.2)
		if ESP then createESP(plr) end
	end)
end

for _,p in pairs(Players:GetPlayers()) do
	if p ~= player then watchPlayer(p) end
end
Players.PlayerAdded:Connect(watchPlayer)

--------------------------------------------------
-- TOGGLES
--------------------------------------------------
espBtn.MouseButton1Click:Connect(function()
	ESP = not ESP
	toggle(espBtn, ESP)
	if not ESP then
		for _,h in pairs(Highlights) do h:Destroy() end
		Highlights = {}
	end
end)

aimBtn.MouseButton1Click:Connect(function()
	AIM = not AIM
	toggle(aimBtn, AIM)
end)

fovBtn.MouseButton1Click:Connect(function()
	FOV = not FOV
	toggle(fovBtn, FOV)
	if not FOV then
		Camera.FieldOfView = DEFAULT_FOV
	end
end)

speedBtn.MouseButton1Click:Connect(function()
	SPEED = not SPEED
	toggle(speedBtn, SPEED)
end)

--------------------------------------------------
-- LOOPS
--------------------------------------------------
RunService.RenderStepped:Connect(function()
	-- SPEED
	local hum = player.Character and player.Character:FindFirstChild("Humanoid")
	if hum then
		hum.WalkSpeed = SPEED and 27 or 16
	end

	-- FOV
	if FOV then
		Camera.FieldOfView = 200
	end

	-- ESP CHECK CONSTANTE
	if ESP then
		for _,p in pairs(Players:GetPlayers()) do
			if p ~= player and p.Character then
				if not Highlights[p] or Highlights[p].Adornee ~= p.Character then
					createESP(p)
				end
			end
		end
	end

	-- AIMBOT VISÍVEL
	if AIM then
		local best, dist = nil, math.huge
		for _,p in pairs(Players:GetPlayers()) do
			if p ~= player and p.Character and p.Character:FindFirstChild("Head") then
				local origin = Camera.CFrame.Position
				local dir = p.Character.Head.Position - origin
				local rayParams = RaycastParams.new()
				rayParams.FilterDescendantsInstances = {player.Character}
				rayParams.FilterType = Enum.RaycastFilterType.Blacklist
				local ray = workspace:Raycast(origin, dir, rayParams)
				if ray and ray.Instance:IsDescendantOf(p.Character) then
					local d = dir.Magnitude
					if d < dist then
						dist = d
						best = p
					end
				end
			end
		end
		if best then
			local cf = Camera.CFrame
			local dir = (best.Character.Head.Position - cf.Position).Unit
			Camera.CFrame = cf:Lerp(CFrame.new(cf.Position, cf.Position+dir), 0.35)
		end
	end
end)
